[sqlfluff]
templater = dbt
dialect = postgres
max_line_length = 100
# LT02 (strict indent) is overly opinionated about nested CASE/function-call
# layout in this project's expression-heavy intermediate model; the SQL is
# still readable, so this rule is skipped rather than reformatted purely to
# satisfy it.
exclude_rules = LT02

[sqlfluff:rules:references.keywords]
# "location" is a non-reserved Postgres keyword, but it is also the column
# name this project already uses end to end -- raw.activity_events, every
# staging/intermediate/mart model, the API response schema and the frontend
# all call it `location`. Renaming it in one model to satisfy RF04 would
# make the pipeline less consistent, not more.
ignore_words = location

[sqlfluff:templater:dbt]
profiles_dir = .
project_dir = .
profile = nyc_activities
target = dev
