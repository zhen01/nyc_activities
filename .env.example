# Copy to .env for local development. Never commit the real .env file.

POSTGRES_USER=nyc_activities
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nyc_activities
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Used by the ingestion module (SQLAlchemy + psycopg). Must match the
# POSTGRES_* values above.
DATABASE_URL=postgresql+psycopg://nyc_activities:change-me@localhost:5432/nyc_activities
